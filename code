<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>StudyFlow — Plan your day. Focus on your goals.</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    /* ==========================================================================
       DESIGN TOKENS & THEME VARIABLES (Premium Minimalism)
       ========================================================================== */
    :root {
      --bg-main: #F8F8F6;
      --bg-surface: #FFFFFF;
      --bg-subtle: #F2F1EE;
      --bg-hover: #EFECE6;
      --text-primary: #252525;
      --text-secondary: #686865;
      --text-muted: #989894;
      --accent: #A99AD6;
      --accent-hover: #9382C7;
      --accent-soft: rgba(169, 154, 214, 0.16);
      --accent-text: #4F3F84;
      --border-color: #EAE9E6;
      --border-strong: #DCDAD5;

      /* Semantic Status Colors (Soft, refined SaaS tones) */
      --status-success: #4E9A6E;
      --status-success-bg: rgba(78, 154, 110, 0.12);
      --status-warning: #C98A32;
      --status-warning-bg: rgba(201, 138, 50, 0.12);
      --status-danger: #C95B5B;
      --status-danger-bg: rgba(201, 91, 91, 0.12);
      --status-info: #5B89C9;
      --status-info-bg: rgba(91, 137, 201, 0.12);

      --shadow-xs: 0 1px 2px rgba(37, 37, 37, 0.03);
      --shadow-sm: 0 4px 12px rgba(37, 37, 37, 0.04);
      --shadow-md: 0 12px 28px rgba(37, 37, 37, 0.08);
      --radius-sm: 8px;
      --radius-md: 12px;
      --radius-lg: 16px;
      --sidebar-width: 256px;
      --transition: 180ms cubic-bezier(0.2, 0, 0, 1);
    }

    [data-theme="dark"] {
      --bg-main: #161618;
      --bg-surface: #1F1F23;
      --bg-subtle: #28282D;
      --bg-hover: #303036;
      --text-primary: #F3F3F1;
      --text-secondary: #A6A6A2;
      --text-muted: #72726E;
      --accent: #A99AD6;
      --accent-hover: #B9ACE2;
      --accent-soft: rgba(169, 154, 214, 0.18);
      --accent-text: #CFC5F0;
      --border-color: #2D2D32;
      --border-strong: #3C3C42;

      --status-success: #64B887;
      --status-success-bg: rgba(100, 184, 135, 0.15);
      --status-warning: #E0A34E;
      --status-warning-bg: rgba(224, 163, 78, 0.15);
      --status-danger: #E07575;
      --status-danger-bg: rgba(224, 117, 117, 0.15);
      --status-info: #78A3E0;
      --status-info-bg: rgba(120, 163, 224, 0.15);

      --shadow-xs: 0 1px 2px rgba(0, 0, 0, 0.2);
      --shadow-sm: 0 4px 14px rgba(0, 0, 0, 0.25);
      --shadow-md: 0 14px 32px rgba(0, 0, 0, 0.4);
    }

    /* ==========================================================================
       RESET & BASE TYPOGRAPHY
       ========================================================================== */
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html, body {
      height: 100%;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      background-color: var(--bg-main);
      color: var(--text-primary);
      font-size: 14px;
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
      transition: background-color var(--transition), color var(--transition);
    }

    button, input, select, textarea {
      font-family: inherit;
      font-size: inherit;
      color: inherit;
      outline: none;
    }

    button {
      cursor: pointer;
      border: none;
      background: transparent;
    }

    /* Custom Scrollbar */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: transparent;
    }
    ::-webkit-scrollbar-thumb {
      background: var(--border-strong);
      border-radius: 99px;
    }

    /* ==========================================================================
       LAYOUT SHELL
       ========================================================================== */
    .app-shell {
      display: flex;
      min-height: 100vh;
      width: 100%;
    }

    /* Sidebar */
    .sidebar {
      width: var(--sidebar-width);
      background: var(--bg-surface);
      border-right: 1px solid var(--border-color);
      display: flex;
      flex-direction: column;
      padding: 24px 16px;
      position: fixed;
      top: 0;
      bottom: 0;
      left: 0;
      z-index: 40;
      transition: transform 240ms ease, background-color var(--transition), border-color var(--transition);
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 0 8px 24px;
      border-bottom: 1px solid var(--border-color);
      margin-bottom: 20px;
    }

    .brand-logo {
      width: 36px;
      height: 36px;
      border-radius: 10px;
      background: var(--accent);
      color: #FFFFFF;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      box-shadow: 0 2px 8px rgba(169, 154, 214, 0.4);
    }

    .brand-text h1 {
      font-size: 16px;
      font-weight: 700;
      letter-spacing: -0.02em;
      line-height: 1.2;
    }

    .brand-text p {
      font-size: 11px;
      color: var(--text-muted);
      margin-top: 2px;
    }

    .nav-list {
      display: flex;
      flex-direction: column;
      gap: 4px;
      flex: 1;
      overflow-y: auto;
    }

    .nav-item {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 10px 12px;
      border-radius: var(--radius-sm);
      color: var(--text-secondary);
      font-weight: 500;
      transition: all var(--transition);
      text-align: left;
      width: 100%;
      position: relative;
    }

    .nav-item:hover {
      background: var(--bg-subtle);
      color: var(--text-primary);
    }

    .nav-item.active {
      background: var(--accent-soft);
      color: var(--accent-text);
      font-weight: 600;
    }

    .nav-item.active svg {
      color: var(--accent);
    }

    .nav-badge {
      margin-left: auto;
      font-size: 11px;
      font-weight: 600;
      padding: 2px 7px;
      border-radius: 99px;
      background: var(--bg-subtle);
      color: var(--text-secondary);
    }

    .nav-item.active .nav-badge {
      background: var(--accent);
      color: #FFFFFF;
    }

    .sidebar-footer {
      padding-top: 16px;
      border-top: 1px solid var(--border-color);
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .theme-toggle-btn {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 10px 12px;
      border-radius: var(--radius-sm);
      background: var(--bg-subtle);
      color: var(--text-secondary);
      font-weight: 500;
      transition: all var(--transition);
    }

    .theme-toggle-btn:hover {
      background: var(--bg-hover);
      color: var(--text-primary);
    }

    /* Mobile Header */
    .mobile-header {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      height: 60px;
      background: var(--bg-surface);
      border-bottom: 1px solid var(--border-color);
      padding: 0 16px;
      align-items: center;
      justify-content: space-between;
      z-index: 35;
    }

    .sidebar-backdrop {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.35);
      z-index: 38;
      backdrop-filter: blur(2px);
    }

    .sidebar-backdrop.open {
      display: block;
    }

    /* Main Content Area */
    .main-content {
      flex: 1;
      margin-left: var(--sidebar-width);
      padding: 32px 40px;
      max-width: 1440px;
      width: 100%;
    }

    /* ==========================================================================
       COMMON UI COMPONENTS
       ========================================================================== */
    .page-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 28px;
      flex-wrap: wrap;
    }

    .page-title {
      font-size: 26px;
      font-weight: 700;
      letter-spacing: -0.025em;
      line-height: 1.2;
    }

    .page-subtitle {
      color: var(--text-secondary);
      font-size: 14px;
      margin-top: 4px;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 10px 16px;
      border-radius: var(--radius-sm);
      font-weight: 500;
      font-size: 13.5px;
      transition: all var(--transition);
      min-height: 40px;
      white-space: nowrap;
    }

    .btn-primary {
      background: var(--accent);
      color: #FFFFFF;
      box-shadow: 0 2px 6px rgba(169, 154, 214, 0.35);
    }

    .btn-primary:hover {
      background: var(--accent-hover);
      transform: translateY(-1px);
    }

    .btn-secondary {
      background: var(--bg-surface);
      border: 1px solid var(--border-color);
      color: var(--text-primary);
    }

    .btn-secondary:hover {
      background: var(--bg-subtle);
      border-color: var(--border-strong);
    }

    .btn-ghost {
      color: var(--text-secondary);
      padding: 8px 10px;
      min-height: 36px;
    }

    .btn-ghost:hover {
      background: var(--bg-subtle);
      color: var(--text-primary);
    }

    .btn-danger {
      background: var(--status-danger-bg);
      color: var(--status-danger);
    }

    .btn-danger:hover {
      background: var(--status-danger);
      color: #FFFFFF;
    }

    .card {
      background: var(--bg-surface);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-lg);
      padding: 22px;
      box-shadow: var(--shadow-xs);
      transition: background-color var(--transition), border-color var(--transition);
    }

    .card-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 18px;
    }

    .card-title {
      font-size: 15.5px;
      font-weight: 600;
      letter-spacing: -0.01em;
    }

    /* Badges & Tags */
    .badge {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 3px 9px;
      border-radius: 6px;
      font-size: 11.5px;
      font-weight: 500;
    }

    .badge-study { background: var(--accent-soft); color: var(--accent-text); }
    .badge-personal { background: var(--status-success-bg); color: var(--status-success); }
    .badge-projects { background: var(--status-info-bg); color: var(--status-info); }
    .badge-work { background: var(--status-warning-bg); color: var(--status-warning); }
    .badge-other { background: var(--bg-subtle); color: var(--text-secondary); }

    .priority-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      display: inline-block;
    }
    .prio-high { background: var(--status-danger); }
    .prio-medium { background: var(--status-warning); }
    .prio-low { background: var(--status-success); }

    /* Form Controls */
    .form-group {
      display: flex;
      flex-direction: column;
      gap: 6px;
      margin-bottom: 16px;
    }

    .form-label {
      font-size: 12.5px;
      font-weight: 500;
      color: var(--text-secondary);
    }

    .form-input, .form-select, .form-textarea {
      width: 100%;
      padding: 10px 12px;
      border-radius: var(--radius-sm);
      border: 1px solid var(--border-color);
      background: var(--bg-main);
      color: var(--text-primary);
      transition: border-color var(--transition), box-shadow var(--transition);
    }

    .form-input:focus, .form-select:focus, .form-textarea:focus {
      border-color: var(--accent);
      box-shadow: 0 0 0 3px var(--accent-soft);
      background: var(--bg-surface);
    }

    .form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }

    /* ==========================================================================
       DASHBOARD GRID & WIDGETS
       ========================================================================== */
    .overview-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
      margin-bottom: 24px;
    }

    .stat-card {
      background: var(--bg-surface);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
      padding: 18px 20px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .stat-label {
      font-size: 12.5px;
      color: var(--text-secondary);
      font-weight: 500;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .stat-value {
      font-size: 26px;
      font-weight: 700;
      letter-spacing: -0.02em;
      margin-top: 10px;
    }

    .stat-meta {
      font-size: 12px;
      color: var(--text-muted);
      margin-top: 4px;
    }

    .dashboard-columns {
      display: grid;
      grid-template-columns: 1.65fr 1fr;
      gap: 20px;
      align-items: start;
    }

    .dashboard-right-col {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    /* Task Item Row */
    .task-list {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .task-item {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      padding: 12px 14px;
      border-radius: var(--radius-md);
      border: 1px solid var(--border-color);
      background: var(--bg-surface);
      transition: all var(--transition);
    }

    .task-item:hover {
      border-color: var(--border-strong);
      background: var(--bg-main);
    }

    .task-item.completed {
      opacity: 0.65;
    }

    .task-checkbox {
      width: 20px;
      height: 20px;
      border-radius: 6px;
      border: 1.5px solid var(--border-strong);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      margin-top: 2px;
      transition: all var(--transition);
      color: transparent;
    }

    .task-checkbox:hover {
      border-color: var(--accent);
    }

    .task-item.completed .task-checkbox {
      background: var(--accent);
      border-color: var(--accent);
      color: #FFFFFF;
    }

    .task-body {
      flex: 1;
      min-width: 0;
    }

    .task-title-row {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }

    .task-title {
      font-weight: 500;
      font-size: 14px;
      color: var(--text-primary);
      word-break: break-word;
    }

    .task-item.completed .task-title {
      text-decoration: line-through;
      color: var(--text-muted);
    }

    .task-desc {
      font-size: 12.5px;
      color: var(--text-secondary);
      margin-top: 3px;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .task-meta {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-top: 8px;
      flex-wrap: wrap;
      font-size: 12px;
      color: var(--text-muted);
    }

    .task-actions {
      display: flex;
      align-items: center;
      gap: 4px;
      opacity: 0.7;
      transition: opacity var(--transition);
    }

    .task-item:hover .task-actions {
      opacity: 1;
    }

    .icon-btn {
      width: 30px;
      height: 30px;
      border-radius: 6px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      color: var(--text-secondary);
      transition: all var(--transition);
    }

    .icon-btn:hover {
      background: var(--bg-subtle);
      color: var(--text-primary);
    }

    .icon-btn.delete:hover {
      background: var(--status-danger-bg);
      color: var(--status-danger);
    }

    /* Mini Weekly Bar Chart */
    .mini-bars {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      height: 110px;
      gap: 8px;
      padding-top: 16px;
    }

    .mini-bar-col {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
      height: 100%;
    }

    .mini-bar-track {
      width: 100%;
      max-width: 28px;
      flex: 1;
      background: var(--bg-subtle);
      border-radius: 6px;
      display: flex;
      align-items: flex-end;
      overflow: hidden;
    }

    .mini-bar-fill {
      width: 100%;
      background: var(--accent);
      border-radius: 6px;
      transition: height 350ms ease;
      min-height: 4px;
    }

    .mini-bar-label {
      font-size: 11px;
      color: var(--text-muted);
      font-weight: 500;
    }

    .mini-bar-col.today .mini-bar-label {
      color: var(--accent-text);
      font-weight: 700;
    }

    /* ==========================================================================
       MY TASKS FILTER BAR
       ========================================================================== */
    .toolbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 20px;
      flex-wrap: wrap;
    }

    .search-box {
      position: relative;
      flex: 1;
      min-width: 220px;
      max-width: 340px;
    }

    .search-box svg {
      position: absolute;
      left: 12px;
      top: 50%;
      transform: translateY(-50%);
      color: var(--text-muted);
      pointer-events: none;
    }

    .search-box input {
      padding-left: 36px;
      background: var(--bg-surface);
    }

    .filter-group {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }

    .filter-select {
      width: auto;
      min-width: 135px;
      background: var(--bg-surface);
      padding: 8px 12px;
      font-size: 13px;
    }

    /* ==========================================================================
       CALENDAR VIEW
       ========================================================================== */
    .calendar-layout {
      display: grid;
      grid-template-columns: 1.7fr 1fr;
      gap: 20px;
      align-items: start;
    }

    .cal-grid-header {
      display: grid;
      grid-template-columns: repeat(7, 1fr);
      text-align: center;
      font-size: 12px;
      font-weight: 600;
      color: var(--text-muted);
      padding-bottom: 10px;
      border-bottom: 1px solid var(--border-color);
      margin-bottom: 8px;
    }

    .cal-grid {
      display: grid;
      grid-template-columns: repeat(7, 1fr);
      gap: 6px;
    }

    .cal-cell {
      aspect-ratio: 1 / 0.95;
      min-height: 68px;
      border-radius: var(--radius-sm);
      border: 1px solid var(--border-color);
      padding: 8px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      cursor: pointer;
      transition: all var(--transition);
      background: var(--bg-surface);
    }

    .cal-cell:hover {
      border-color: var(--accent);
    }

    .cal-cell.other-month {
      opacity: 0.4;
      background: var(--bg-main);
    }

    .cal-cell.selected {
      border-color: var(--accent);
      background: var(--accent-soft);
    }

    .cal-cell.today .cal-day-num {
      background: var(--accent);
      color: #FFFFFF;
      width: 24px;
      height: 24px;
      border-radius: 50%;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }

    .cal-day-num {
      font-size: 12.5px;
      font-weight: 600;
    }

    .cal-dots {
      display: flex;
      gap: 3px;
      flex-wrap: wrap;
    }

    .cal-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--accent);
    }

    /* ==========================================================================
       HABITS TRACKER
       ========================================================================== */
    .habit-card {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 18px 20px;
      background: var(--bg-surface);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
      margin-bottom: 12px;
      flex-wrap: wrap;
    }

    .habit-info h4 {
      font-size: 15px;
      font-weight: 600;
    }

    .habit-streak {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 12.5px;
      color: var(--accent-text);
      background: var(--accent-soft);
      padding: 3px 10px;
      border-radius: 99px;
      font-weight: 600;
      margin-top: 6px;
    }

    .habit-days {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .habit-day-btn {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 4px;
      padding: 6px 8px;
      border-radius: var(--radius-sm);
      border: 1px solid var(--border-color);
      min-width: 44px;
      transition: all var(--transition);
    }

    .habit-day-btn span {
      font-size: 11px;
      color: var(--text-muted);
    }

    .habit-day-circle {
      width: 22px;
      height: 22px;
      border-radius: 50%;
      border: 1.5px solid var(--border-strong);
      display: flex;
      align-items: center;
      justify-content: center;
      color: transparent;
      transition: all var(--transition);
    }

    .habit-day-btn.done {
      border-color: var(--accent);
      background: var(--accent-soft);
    }

    .habit-day-btn.done .habit-day-circle {
      background: var(--accent);
      border-color: var(--accent);
      color: #FFFFFF;
    }

    /* ==========================================================================
       STUDY PLANNER (БЖБ, СОЧ, IELTS, SAT, HSK)
       ========================================================================== */
    .exam-pills {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      margin-bottom: 20px;
    }

    .exam-pill {
      padding: 8px 14px;
      border-radius: 99px;
      border: 1px solid var(--border-color);
      background: var(--bg-surface);
      font-size: 13px;
      font-weight: 500;
      color: var(--text-secondary);
      transition: all var(--transition);
    }

    .exam-pill:hover {
      border-color: var(--accent);
      color: var(--text-primary);
    }

    .exam-pill.active {
      background: var(--accent);
      border-color: var(--accent);
      color: #FFFFFF;
    }

    .study-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 16px;
    }

    .study-card {
      background: var(--bg-surface);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
      padding: 20px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 14px;
    }

    .progress-bar-bg {
      width: 100%;
      height: 8px;
      background: var(--bg-subtle);
      border-radius: 99px;
      overflow: hidden;
    }

    .progress-bar-fill {
      height: 100%;
      background: var(--accent);
      border-radius: 99px;
      transition: width 300ms ease;
    }

    /* ==========================================================================
       FOCUS MODE (POMODORO)
       ========================================================================== */
    .focus-container {
      max-width: 540px;
      margin: 0 auto;
      text-align: center;
    }

    .mode-tabs {
      display: inline-flex;
      background: var(--bg-subtle);
      padding: 4px;
      border-radius: var(--radius-md);
      margin-bottom: 28px;
      gap: 4px;
    }

    .mode-tab {
      padding: 8px 16px;
      border-radius: var(--radius-sm);
      font-size: 13px;
      font-weight: 500;
      color: var(--text-secondary);
      transition: all var(--transition);
    }

    .mode-tab.active {
      background: var(--bg-surface);
      color: var(--text-primary);
      box-shadow: var(--shadow-xs);
    }

    .timer-ring-wrapper {
      position: relative;
      width: 260px;
      height: 260px;
      margin: 0 auto 28px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .timer-svg {
      position: absolute;
      inset: 0;
      transform: rotate(-90deg);
    }

    .timer-display {
      font-size: 52px;
      font-weight: 700;
      letter-spacing: -0.03em;
      font-variant-numeric: tabular-nums;
    }

    .timer-sub {
      font-size: 13px;
      color: var(--text-secondary);
      margin-top: 4px;
    }

    .focus-controls {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      margin-bottom: 24px;
    }

    /* ==========================================================================
       STATISTICS CHARTS
       ========================================================================== */
    .stats-grid {
      display: grid;
      grid-template-columns: 1.5fr 1fr;
      gap: 20px;
    }

    .category-row {
      margin-bottom: 14px;
    }

    .category-row-header {
      display: flex;
      justify-content: space-between;
      font-size: 13px;
      margin-bottom: 6px;
    }

    /* ==========================================================================
       MODAL & TOAST NOTIFICATIONS
       ========================================================================== */
    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(20, 20, 22, 0.45);
      backdrop-filter: blur(3px);
      display: none;
      align-items: center;
      justify-content: center;
      padding: 16px;
      z-index: 60;
    }

    .modal-overlay.open {
      display: flex;
      animation: fadeIn 160ms ease;
    }

    .modal-box {
      background: var(--bg-surface);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-lg);
      width: 100%;
      max-width: 480px;
      padding: 24px;
      box-shadow: var(--shadow-md);
      max-height: 90vh;
      overflow-y: auto;
    }

    .modal-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 20px;
    }

    .modal-title {
      font-size: 17px;
      font-weight: 600;
    }

    .modal-footer {
      display: flex;
      justify-content: flex-end;
      gap: 10px;
      margin-top: 22px;
      padding-top: 16px;
      border-top: 1px solid var(--border-color);
    }

    .toast-container {
      position: fixed;
      bottom: 24px;
      right: 24px;
      display: flex;
      flex-direction: column;
      gap: 10px;
      z-index: 80;
      pointer-events: none;
    }

    .toast {
      background: var(--bg-surface);
      border: 1px solid var(--border-color);
      border-left: 4px solid var(--accent);
      color: var(--text-primary);
      padding: 12px 16px;
      border-radius: var(--radius-sm);
      box-shadow: var(--shadow-md);
      font-size: 13.5px;
      font-weight: 500;
      display: flex;
      align-items: center;
      gap: 10px;
      pointer-events: auto;
      animation: slideUp 200ms ease;
      max-width: 340px;
    }

    .empty-state {
      text-align: center;
      padding: 36px 20px;
      color: var(--text-muted);
      border: 1px dashed var(--border-strong);
      border-radius: var(--radius-md);
    }

    .empty-state p {
      font-size: 14px;
      color: var(--text-secondary);
      margin-bottom: 6px;
      font-weight: 500;
    }

    .view-section {
      display: none;
    }
    .view-section.active {
      display: block;
      animation: fadeIn 180ms ease;
    }

    @keyframes fadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes slideUp {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* ==========================================================================
       RESPONSIVE BREAKPOINTS (375px Mobile, Tablet, Laptop, Desktop)
       ========================================================================== */
    @media (max-width: 1080px) {
      .overview-grid {
        grid-template-columns: repeat(2, 1fr);
      }
      .dashboard-columns, .calendar-layout, .stats-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 820px) {
      .mobile-header {
        display: flex;
      }
      .sidebar {
        transform: translateX(-100%);
      }
      .sidebar.open {
        transform: translateX(0);
      }
      .main-content {
        margin-left: 0;
        padding: 80px 18px 32px;
      }
      .page-title {
        font-size: 22px;
      }
    }

    @media (max-width: 480px) {
      .overview-grid {
        grid-template-columns: 1fr;
      }
      .form-row {
        grid-template-columns: 1fr;
      }
      .cal-cell {
        min-height: 52px;
        padding: 5px;
      }
      .toast-container {
        left: 16px;
        right: 16px;
        bottom: 16px;
      }
      .toast {
        max-width: 100%;
      }
    }
  </style>
</head>
