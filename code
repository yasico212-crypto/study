    let state = {
      data: null,
      currentView: 'dashboard',
      calendarMonth: new Date(),
      selectedCalendarDate: getTodayStr(0),
      selectedExamFilter: 'all'
    };

    function loadState() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (raw) {
          state.data = JSON.parse(raw);
        } else {
          state.data = createDefaultData();
          saveState();
        }
      } catch (e) {
        console.error('Failed to load state:', e);
        state.data = createDefaultData();
      }
    }

    function saveState() {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(state.data));
      } catch (e) {
        showToast('Unable to save data to browser storage.');
      }
    }

    /* ==========================================================================
       NOTIFICATIONS (TOAST) & THEME
       ========================================================================== */
    function showToast(message) {
      const container = document.getElementById('toastContainer');
      const toast = document.createElement('div');
      toast.className = 'toast';
      toast.innerHTML = `
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        <span>${escapeHtml(message)}</span>
      `;
      container.appendChild(toast);
      setTimeout(() => {
        toast.style.opacity = '0';
        toast.style.transform = 'translateY(6px)';
        toast.style.transition = 'all 200ms ease';
        setTimeout(() => toast.remove(), 220);
      }, 2800);
    }

    function applyTheme(theme) {
      document.documentElement.setAttribute('data-theme', theme);
      const isDark = theme === 'dark';
      document.getElementById('themeLabel').textContent = isDark ? 'Dark Mode' : 'Light Mode';
      document.getElementById('themeStateText').textContent = isDark ? 'On' : 'Off';
      const select = document.getElementById('settingsThemeSelect');
      if (select) select.value = theme;
    }

    function escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    /* ==========================================================================
       NAVIGATION & MOBILE MENU
       ========================================================================== */
    function switchView(viewName) {
      state.currentView = viewName;
      document.querySelectorAll('.nav-item').forEach(btn => {
        btn.classList.toggle('active', btn.dataset.view === viewName);
      });
      document.querySelectorAll('.view-section').forEach(sec => {
        sec.classList.toggle('active', sec.id === `view-${viewName}`);
      });

      // Close mobile drawer
      document.getElementById('sidebar').classList.remove('open');
      document.getElementById('sidebarBackdrop').classList.remove('open');

      renderAll();
    }

    /* ==========================================================================
       TASK CRUD & RENDERING
       ========================================================================== */
    function openTaskModal(presetDate = null, taskToEdit = null) {
      const modal = document.getElementById('taskModal');
      const titleEl = document.getElementById('taskModalTitle');
      document.getElementById('taskForm').reset();

      if (taskToEdit) {
        titleEl.textContent = 'Edit Task';
        document.getElementById('taskIdInput').value = taskToEdit.id;
        document.getElementById('taskTitleInput').value = taskToEdit.title;
        document.getElementById('taskDescInput').value = taskToEdit.description || '';
        document.getElementById('taskDateInput').value = taskToEdit.date;
        document.getElementById('taskTimeInput').value = taskToEdit.time || '';
        document.getElementById('taskCategoryInput').value = taskToEdit.category;
        document.getElementById('taskPriorityInput').value = taskToEdit.priority;
      } else {
        titleEl.textContent = 'New Task';
        document.getElementById('taskIdInput').value = '';
        document.getElementById('taskDateInput').value = presetDate || getTodayStr(0);
        document.getElementById('taskCategoryInput').value = 'Study';
        document.getElementById('taskPriorityInput').value = 'medium';
      }
      modal.classList.add('open');
      setTimeout(() => document.getElementById('taskTitleInput').focus(), 50);
    }

    function closeModal(id) {
      document.getElementById(id).classList.remove('open');
    }

    function toggleTaskComplete(id) {
      const task = state.data.tasks.find(t => t.id === id);
      if (!task) return;
      task.completed = !task.completed;
      task.completedDate = task.completed ? getTodayStr(0) : null;
      saveState();
      renderAll();
      showToast(task.completed ? 'Task marked as completed.' : 'Task reopened.');
    }

    function deleteTask(id) {
      state.data.tasks = state.data.tasks.filter(t => t.id !== id);
      saveState();
      renderAll();
      showToast('Task deleted.');
    }

    function editTaskById(id) {
      const task = state.data.tasks.find(t => t.id === id);
      if (task) openTaskModal(null, task);
    }

    function formatFriendlyDate(dateStr) {
      if (!dateStr) return 'No date';
      const today = getTodayStr(0);
      const tomorrow = getTodayStr(1);
      if (dateStr === today) return 'Today';
      if (dateStr === tomorrow) return 'Tomorrow';
      const [y, m, d] = dateStr.split('-');
      const dateObj = new Date(Number(y), Number(m) - 1, Number(d));
      return dateObj.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
    }

    function createTaskElement(task) {
      const catClass = `badge-${task.category.toLowerCase()}`;
      const prioClass = `prio-${task.priority}`;
      const div = document.createElement('div');
      div.className = `task-item ${task.completed ? 'completed' : ''}`;
      div.innerHTML = `
        <button class="task-checkbox" aria-label="Toggle task" onclick="toggleTaskComplete('${task.id}')">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
        </button>
        <div class="task-body">
          <div class="task-title-row">
            <span class="task-title">${escapeHtml(task.title)}</span>
          </div>
          ${task.description ? `<div class="task-desc">${escapeHtml(task.description)}</div>` : ''}
          <div class="task-meta">
            <span class="badge ${catClass}">${escapeHtml(task.category)}</span>
            <span style="display:inline-flex;align-items:center;gap:5px;text-transform:capitalize;">
              <span class="priority-dot ${prioClass}"></span>${task.priority}
            </span>
            <span>${formatFriendlyDate(task.date)}${task.time ? ' • ' + task.time : ''}</span>
          </div>
        </div>
        <div class="task-actions">
          <button class="icon-btn" title="Edit task" onclick="editTaskById('${task.id}')">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
          </button>
          <button class="icon-btn delete" title="Delete task" onclick="deleteTask('${task.id}')">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
          </button>
        </div>
      `;
      return div;
    }

    /* ==========================================================================
       RENDER: DASHBOARD
       ========================================================================== */
    function renderDashboard() {
      const todayStr = getTodayStr(0);
      const userName = state.data.settings.userName;
      document.getElementById('dashboardGreeting').textContent = userName
        ? `Good afternoon, ${userName}!`
        : 'Good afternoon!';

      const now = new Date();
      document.getElementById('dashboardDate').textContent = now.toLocaleDateString('en-US', {
        weekday: 'long',
        month: 'long',
        day: 'numeric',
        year: 'numeric'
      });

      const allTasks = state.data.tasks;
      const todayTasks = allTasks.filter(t => t.date === todayStr);
      const todayDone = todayTasks.filter(t => t.completed).length;
      const totalDone = allTasks.filter(t => t.completed).length;
      const remaining = allTasks.length - totalDone;
      const rate = allTasks.length ? Math.round((totalDone / allTasks.length) * 100) : 0;

      document.getElementById('dashTodayCount').textContent = `${todayDone} / ${todayTasks.length}`;
      document.getElementById('dashRemainingCount').textContent = remaining;
      document.getElementById('dashCompletedCount').textContent = totalDone;
      document.getElementById('dashCompletionRate').textContent = `${rate}% completion rate`;
      document.getElementById('dashFocusCount').textContent = state.data.focusSessions || 0;
      document.getElementById('navTaskBadge').textContent = remaining;

      // Today's Tasks List
      const todayContainer = document.getElementById('dashboardTodayList');
      todayContainer.innerHTML = '';
      if (todayTasks.length === 0) {
        todayContainer.innerHTML = `
          <div class="empty-state">
            <p>No tasks scheduled for today</p>
            <span>Click "+ Add Task" to plan your day.</span>
          </div>`;
      } else {
        todayTasks.forEach(t => todayContainer.appendChild(createTaskElement(t)));
      }

      // Upcoming Deadlines
      const upcomingContainer = document.getElementById('dashboardUpcomingList');
      upcomingContainer.innerHTML = '';
      const upcoming = allTasks
        .filter(t => !t.completed && t.date > todayStr)
        .sort((a, b) => a.date.localeCompare(b.date))
        .slice(0, 4);

      if (upcoming.length === 0) {
        upcomingContainer.innerHTML = `<div class="empty-state"><p>All caught up</p><span>No upcoming deadlines found.</span></div>`;
      } else {
        upcoming.forEach(t => upcomingContainer.appendChild(createTaskElement(t)));
      }

      // Weekly Progress Mini Chart
      renderWeeklyBars('dashboardWeeklyBars', true);
    }

    function getLast7DaysStats() {
      const days = [];
      for (let i = 6; i >= 0; i--) {
        const dStr = getTodayStr(-i);
        const [y, m, d] = dStr.split('-');
        const dateObj = new Date(Number(y), Number(m) - 1, Number(d));
        const label = dateObj.toLocaleDateString('en-US', { weekday: 'short' });
        const count = state.data.tasks.filter(t => t.completed && t.completedDate === dStr).length;
        days.push({ date: dStr, label, count, isToday: i === 0 });
      }
      return days;
    }

    function renderWeeklyBars(containerId, updateBadge = false) {
      const container = document.getElementById(containerId);
      if (!container) return;
      const days = getLast7DaysStats();
      const maxVal = Math.max(...days.map(d => d.count), 3);
      const totalWeek = days.reduce((acc, d) => acc + d.count, 0);

      if (updateBadge) {
        const badge = document.getElementById('weeklyTotalBadge');
        if (badge) badge.textContent = `${totalWeek} done`;
      }

      container.innerHTML = days.map(d => {
        const pct = Math.round((d.count / maxVal) * 100);
        return `
          <div class="mini-bar-col ${d.isToday ? 'today' : ''}" title="${d.label}: ${d.count} tasks">
            <div class="mini-bar-track">
              <div class="mini-bar-fill" style="height:${Math.max(pct, 6)}%"></div>
            </div>
            <span class="mini-bar-label">${d.label}</span>
          </div>
        `;
      }).join('');
    }

    /* ==========================================================================
       RENDER: MY TASKS (Search, Filter, Sort)
       ========================================================================== */
    function renderMyTasks() {
      const query = document.getElementById('taskSearchInput').value.trim().toLowerCase();
      const catFilter = document.getElementById('filterCategory').value;
      const statusFilter = document.getElementById('filterStatus').value;
      const prioFilter = document.getElementById('filterPriority').value;
      const sortBy = document.getElementById('sortTasksSelect').value;

      let filtered = state.data.tasks.filter(t => {
        const matchesQuery = t.title.toLowerCase().includes(query) || (t.description && t.description.toLowerCase().includes(query));
        const matchesCat = catFilter === 'all' || t.category === catFilter;
        const matchesStatus = statusFilter === 'all' || (statusFilter === 'completed' ? t.completed : !t.completed);
        const matchesPrio = prioFilter === 'all' || t.priority === prioFilter;
        return matchesQuery && matchesCat && matchesStatus && matchesPrio;
      });

      const prioWeight = { high: 3, medium: 2, low: 1 };
      filtered.sort((a, b) => {
        if (sortBy === 'date-asc') return (a.date || '9999').localeCompare(b.date || '9999');
        if (sortBy === 'date-desc') return (b.date || '').localeCompare(a.date || '');
        if (sortBy === 'priority') return prioWeight[b.priority] - prioWeight[a.priority];
        return (b.createdAt || 0) - (a.createdAt || 0);
      });

      const container = document.getElementById('allTasksList');
      container.innerHTML = '';
      if (filtered.length === 0) {
        container.innerHTML = `
          <div class="empty-state">
            <p>No matching tasks</p>
            <span>Try adjusting your search query or filters.</span>
          </div>`;
      } else {
        filtered.forEach(t => container.appendChild(createTaskElement(t)));
      }
    }

    /* ==========================================================================
       RENDER: CALENDAR
       ========================================================================== */
    function renderCalendar() {
      const year = state.calendarMonth.getFullYear();
      const month = state.calendarMonth.getMonth();
      const firstDay = new Date(year, month, 1);
      const lastDay = new Date(year, month + 1, 0);

      document.getElementById('calendarMonthLabel').textContent = firstDay.toLocaleDateString('en-US', {
        month: 'long',
        year: 'numeric'
      });

      // Monday = 0 ... Sunday = 6
      let startOffset = firstDay.getDay() - 1;
      if (startOffset < 0) startOffset = 6;

      const grid = document.getElementById('calendarGrid');
      grid.innerHTML = '';
      const todayStr = getTodayStr(0);

      // Previous month padding
      const prevMonthLast = new Date(year, month, 0).getDate();
      for (let i = startOffset - 1; i >= 0; i--) {
        const cell = document.createElement('div');
        cell.className = 'cal-cell other-month';
        cell.innerHTML = `<span class="cal-day-num">${prevMonthLast - i}</span>`;
        grid.appendChild(cell);
      }

      // Current month days
      for (let d = 1; d <= lastDay.getDate(); d++) {
        const dateStr = `${year}-${String(month + 1).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
        const dayTasks = state.data.tasks.filter(t => t.date === dateStr);
        const dayExams = state.data.studyPlans.filter(s => s.date === dateStr);
        const totalEvents = dayTasks.length + dayExams.length;

        const cell = document.createElement('div');
        cell.className = `cal-cell ${dateStr === todayStr ? 'today' : ''} ${dateStr === state.selectedCalendarDate ? 'selected' : ''}`;
        cell.onclick = () => {
          state.selectedCalendarDate = dateStr;
          renderCalendar();
        };

        let dotsHtml = '';
        for (let k = 0; k < Math.min(totalEvents, 4); k++) {
          dotsHtml += `<span class="cal-dot"></span>`;
        }

        cell.innerHTML = `
          <span class="cal-day-num">${d}</span>
          <div class="cal-dots">${dotsHtml}</div>
        `;
        grid.appendChild(cell);
      }

      // Render Selected Date Panel
      const selDate = state.selectedCalendarDate;
      const [sy, sm, sd] = selDate.split('-');
      const selObj = new Date(Number(sy), Number(sm) - 1, Number(sd));
      document.getElementById('selectedDateHeading').textContent = selObj.toLocaleDateString('en-US', {
        weekday: 'long',
        month: 'short',
        day: 'numeric'
      });

      const dayContainer = document.getElementById('calendarDayTasks');
      dayContainer.innerHTML = '';
      const tasksForDay = state.data.tasks.filter(t => t.date === selDate);
      const examsForDay = state.data.studyPlans.filter(s => s.date === selDate);

      examsForDay.forEach(ex => {
        const div = document.createElement('div');
        div.className = 'task-item';
        div.innerHTML = `
          <div class="task-body">
            <div class="task-title-row">
              <span class="badge badge-study">${escapeHtml(ex.exam)}</span>
              <span class="task-title">${escapeHtml(ex.subject)}</span>
            </div>
            <div class="task-meta">Scheduled Exam / Assessment</div>
          </div>
        `;
        dayContainer.appendChild(div);
      });

      tasksForDay.forEach(t => dayContainer.appendChild(createTaskElement(t)));

      if (tasksForDay.length === 0 && examsForDay.length === 0) {
        dayContainer.innerHTML = `
          <div class="empty-state">
            <p>Nothing scheduled</p>
            <span>Click "+ Add Event / Task" to schedule this day.</span>
          </div>`;
      }
    }

    /* ==========================================================================
       RENDER: HABITS & STREAKS
       ========================================================================== */
    function openHabitModal() {
      document.getElementById('habitForm').reset();
      document.getElementById('habitModal').classList.add('open');
    }

    function calculateStreak(completedDates) {
      if (!completedDates || completedDates.length === 0) return 0;
      const set = new Set(completedDates);
      let streak = 0;
      let offset = 0;
      // Check today; if not done today, check if streak is alive from yesterday
      if (!set.has(getTodayStr(0))) {
        offset = -1;
      }
      while (set.has(getTodayStr(offset))) {
        streak++;
        offset--;
      }
      return streak;
    }

    function toggleHabitDate(habitId, dateStr) {
      const habit = state.data.habits.find(h => h.id === habitId);
      if (!habit) return;
      const idx = habit.completedDates.indexOf(dateStr);
      if (idx > -1) {
        habit.completedDates.splice(idx, 1);
      } else {
        habit.completedDates.push(dateStr);
        showToast('Habit progress logged!');
      }
      saveState();
      renderHabits();
    }

    function deleteHabit(habitId) {
      state.data.habits = state.data.habits.filter(h => h.id !== habitId);
      saveState();
      renderHabits();
      showToast('Habit removed.');
    }

    function renderHabits() {
      const container = document.getElementById('habitsListContainer');
      if (state.data.habits.length === 0) {
        container.innerHTML = `
          <div class="card empty-state">
            <p>No habits tracked yet</p>
            <span>Create a daily habit to start building consistency.</span>
          </div>`;
        return;
      }

      const last5Days = [];
      for (let i = 4; i >= 0; i--) {
        const dStr = getTodayStr(-i);
        const [y, m, d] = dStr.split('-');
        const dateObj = new Date(Number(y), Number(m) - 1, Number(d));
        last5Days.push({
          dateStr: dStr,
          label: i === 0 ? 'Today' : dateObj.toLocaleDateString('en-US', { weekday: 'short' })
        });
      }

      container.innerHTML = state.data.habits.map(habit => {
        const streak = calculateStreak(habit.completedDates);
        const daysButtons = last5Days.map(day => {
          const isDone = habit.completedDates.includes(day.dateStr);
          return `
            <button class="habit-day-btn ${isDone ? 'done' : ''}" onclick="toggleHabitDate('${habit.id}', '${day.dateStr}')">
              <span>${day.label}</span>
              <div class="habit-day-circle">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
              </div>
            </button>
          `;
        }).join('');

        return `
          <div class="habit-card">
            <div class="habit-info">
              <h4>${escapeHtml(habit.name)}</h4>
              <div class="habit-streak">
                <span>${streak} day streak</span>
                <span style="opacity:0.6;">• ${escapeHtml(habit.frequency)}</span>
              </div>
            </div>
            <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;">
              <div class="habit-days">${daysButtons}</div>
              <button class="icon-btn delete" title="Delete habit" onclick="deleteHabit('${habit.id}')">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
              </button>
            </div>
          </div>
        `;
      }).join('');
    }

    /* ==========================================================================
       RENDER: STUDY PLANNER (БЖБ, СОЧ, IELTS, SAT, HSK)
       ========================================================================== */
    function openStudyModal() {
      document.getElementById('studyForm').reset();
      document.getElementById('studyExamDate').value = getTodayStr(7);
      document.getElementById('studyModal').classList.add('open');
    }

    function toggleStudyTopic(planId, topicIdx) {
      const plan = state.data.studyPlans.find(p => p.id === planId);
      if (!plan || !plan.topics[topicIdx]) return;
      plan.topics[topicIdx].done = !plan.topics[topicIdx].done;
      saveState();
      renderStudyPlanner();
    }

    function deleteStudyPlan(planId) {
      state.data.studyPlans = state.data.studyPlans.filter(p => p.id !== planId);
      saveState();
      renderStudyPlanner();
      showToast('Study plan deleted.');
    }

    function renderStudyPlanner() {
      const grid = document.getElementById('studyPlansGrid');
      const filter = state.selectedExamFilter;
      const plans = state.data.studyPlans.filter(p => filter === 'all' || p.exam === filter);

      if (plans.length === 0) {
        grid.innerHTML = `
          <div class="card empty-state" style="grid-column:1/-1;">
            <p>No study plans for this category</p>
            <span>Click "+ Add Study Plan" to organize your exam preparation.</span>
          </div>`;
        return;
      }

      grid.innerHTML = plans.map(plan => {
        const doneCount = plan.topics.filter(t => t.done).length;
        const pct = plan.topics.length ? Math.round((doneCount / plan.topics.length) * 100) : 0;

        // Days remaining calculation
        const today = new Date(getTodayStr(0));
        const target = new Date(plan.date);
        const diffDays = Math.ceil((target - today) / (1000 * 60 * 60 * 24));
        const daysText = diffDays > 0 ? `${diffDays} days left` : (diffDays === 0 ? 'Exam today' : 'Completed date');

        const topicsHtml = plan.topics.map((t, idx) => `
          <div style="display:flex;align-items:center;gap:8px;padding:6px 0;cursor:pointer;" onclick="toggleStudyTopic('${plan.id}', ${idx})">
            <div class="task-checkbox" style="width:17px;height:17px;${t.done ? 'background:var(--accent);border-color:var(--accent);color:#fff;' : ''}">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
            </div>
            <span style="font-size:13px;${t.done ? 'text-decoration:line-through;color:var(--text-muted);' : ''}">${escapeHtml(t.name)}</span>
          </div>
        `).join('');

        return `
          <div class="study-card">
            <div>
              <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;">
                <span class="badge badge-study">${escapeHtml(plan.exam)}</span>
                <div style="display:flex;align-items:center;gap:6px;">
                  <span style="font-size:12px;color:var(--text-secondary);font-weight:500;">${daysText}</span>
                  <button class="icon-btn delete" title="Remove plan" onclick="deleteStudyPlan('${plan.id}')">✕</button>
                </div>
              </div>
              <h4 style="font-size:15.5px;font-weight:600;margin-bottom:4px;">${escapeHtml(plan.subject)}</h4>
              <p style="font-size:12px;color:var(--text-muted);margin-bottom:14px;">Target Date: ${formatFriendlyDate(plan.date)}</p>
              <div style="margin-bottom:12px;">${topicsHtml}</div>
            </div>
            <div>
              <div style="display:flex;justify-content:space-between;font-size:12px;color:var(--text-secondary);margin-bottom:6px;">
                <span>Syllabus Readiness</span>
                <span>${pct}%</span>
              </div>
              <div class="progress-bar-bg">
                <div class="progress-bar-fill" style="width:${pct}%"></div>
              </div>
            </div>
          </div>
        `;
      }).join('');
    }

    /* ==========================================================================
       FOCUS MODE (POMODORO TIMER)
       ========================================================================== */
    let timerState = {
      mode: 'focus',
      totalSeconds: 25 * 60,
      remainingSeconds: 25 * 60,
      isRunning: false,
      intervalId: null
    };

    const CIRCLE_CIRCUMFERENCE = 741.4;

    function updateTimerUI() {
      const mins = Math.floor(timerState.remainingSeconds / 60);
      const secs = timerState.remainingSeconds % 60;
      document.getElementById('timerDisplay').textContent =
        `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;

      const progress = timerState.remainingSeconds / timerState.totalSeconds;
      const offset = CIRCLE_CIRCUMFERENCE * (1 - progress);
      document.getElementById('timerProgressCircle').style.strokeDashoffset = offset;
      document.getElementById('timerStartPauseBtn').textContent = timerState.isRunning ? 'Pause' : 'Start';
    }

    function setTimerMode(mode, minutes) {
      pauseTimer();
      timerState.mode = mode;
      timerState.totalSeconds = minutes * 60;
      timerState.remainingSeconds = minutes * 60;
      document.getElementById('timerStatusLabel').textContent =
        mode === 'focus' ? 'Ready to focus' : 'Take a mindful break';

      document.querySelectorAll('.mode-tab').forEach(tab => {
        tab.classList.toggle('active', tab.dataset.mode === mode);
      });
      updateTimerUI();
    }

    function startTimer() {
      if (timerState.isRunning) return;
      timerState.isRunning = true;
      document.getElementById('timerStatusLabel').textContent =
        timerState.mode === 'focus' ? 'Deep focus in progress...' : 'Resting...';
      updateTimerUI();

      timerState.intervalId = setInterval(() => {
        if (timerState.remainingSeconds > 0) {
          timerState.remainingSeconds--;
          updateTimerUI();
        } else {
          pauseTimer();
          if (timerState.mode === 'focus') {
            state.data.focusSessions = (state.data.focusSessions || 0) + 1;
            saveState();
            renderDashboard();
            showToast('Focus session completed! Great work.');
          } else {
            showToast('Break finished. Ready for your next session?');
          }
          timerState.remainingSeconds = timerState.totalSeconds;
          updateTimerUI();
        }
      }, 1000);
    }

    function pauseTimer() {
      timerState.isRunning = false;
      clearInterval(timerState.intervalId);
      updateTimerUI();
    }

    function renderFocusTasksSelect() {
      const select = document.getElementById('focusTaskSelect');
      const currentVal = select.value;
      const activeTasks = state.data.tasks.filter(t => !t.completed);
      select.innerHTML = `<option value="">General Study Session</option>` +
        activeTasks.map(t => `<option value="${t.id}">${escapeHtml(t.title)}</option>`).join('');
      select.value = currentVal;
    }

    /* ==========================================================================
       RENDER: STATISTICS
       ========================================================================== */
    function renderStatistics() {
      const all = state.data.tasks;
      const done = all.filter(t => t.completed).length;
      const rate = all.length ? Math.round((done / all.length) * 100) : 0;

      let bestStreak = 0;
      state.data.habits.forEach(h => {
        const s = calculateStreak(h.completedDates);
        if (s > bestStreak) bestStreak = s;
      });

      const focusMins = (state.data.focusSessions || 0) * 25;

      document.getElementById('statRate').textContent = `${rate}%`;
      document.getElementById('statDone').textContent = done;
      document.getElementById('statBestStreak').textContent = `${bestStreak} days`;
      document.getElementById('statFocusMinutes').textContent = `${focusMins} min`;

      renderWeeklyBars('statsWeeklyChart', false);

      // Category breakdown
      const categories = ['Study', 'Personal', 'Projects', 'Work', 'Other'];
      const breakdownEl = document.getElementById('statsCategoryBreakdown');
      breakdownEl.innerHTML = categories.map(cat => {
        const count = all.filter(t => t.category === cat).length;
        const pct = all.length ? Math.round((count / all.length) * 100) : 0;
        return `
          <div class="category-row">
            <div class="category-row-header">
              <span style="font-weight:500;">${cat}</span>
              <span style="color:var(--text-secondary);">${count} tasks (${pct}%)</span>
            </div>
            <div class="progress-bar-bg">
              <div class="progress-bar-fill" style="width:${pct}%"></div>
            </div>
          </div>
        `;
      }).join('');
    }

    /* ==========================================================================
       MASTER RENDER & EVENT LISTENERS
       ========================================================================== */
    function renderAll() {
      renderDashboard();
      renderMyTasks();
      renderCalendar();
      renderHabits();
      renderStudyPlanner();
      renderFocusTasksSelect();
      renderStatistics();
      document.getElementById('settingsUserName').value = state.data.settings.userName || '';
    }

    document.addEventListener('DOMContentLoaded', () => {
      loadState();
      applyTheme(state.data.settings.theme || 'light');
      renderAll();
      updateTimerUI();

      // Sidebar Navigation
      document.querySelectorAll('.nav-item').forEach(btn => {
        btn.addEventListener('click', () => switchView(btn.dataset.view));
      });

      // Mobile Drawer
      const sidebar = document.getElementById('sidebar');
      const backdrop = document.getElementById('sidebarBackdrop');
      document.getElementById('mobileMenuBtn').addEventListener('click', () => {
        sidebar.classList.add('open');
        backdrop.classList.add('open');
      });
      backdrop.addEventListener('click', () => {
        sidebar.classList.remove('open');
        backdrop.classList.remove('open');
      });

      // Sidebar Theme Toggle
      document.getElementById('sidebarThemeToggle').addEventListener('click', () => {
        const nextTheme = state.data.settings.theme === 'dark' ? 'light' : 'dark';
        state.data.settings.theme = nextTheme;
        applyTheme(nextTheme);
        saveState();
      });

      // Task Form Submit
      document.getElementById('taskForm').addEventListener('submit', e => {
        e.preventDefault();
        const id = document.getElementById('taskIdInput').value;
        const title = document.getElementById('taskTitleInput').value.trim();
        if (!title) return;

        const payload = {
          title,
          description: document.getElementById('taskDescInput').value.trim(),
          date: document.getElementById('taskDateInput').value,
          time: document.getElementById('taskTimeInput').value,
          category: document.getElementById('taskCategoryInput').value,
          priority: document.getElementById('taskPriorityInput').value
        };

        if (id) {
          const existing = state.data.tasks.find(t => t.id === id);
          if (existing) Object.assign(existing, payload);
          showToast('Task updated successfully.');
        } else {
          state.data.tasks.unshift({
            id: 't_' + Date.now(),
            ...payload,
            completed: false,
            completedDate: null,
            createdAt: Date.now()
          });
          showToast('Task added to your planner.');
        }

        saveState();
        closeModal('taskModal');
        renderAll();
      });

      // Habit Form Submit
      document.getElementById('habitForm').addEventListener('submit', e => {
        e.preventDefault();
        const name = document.getElementById('habitNameInput').value.trim();
        if (!name) return;
        state.data.habits.push({
          id: 'h_' + Date.now(),
          name,
          frequency: document.getElementById('habitFreqInput').value,
          completedDates: []
        });
        saveState();
        closeModal('habitModal');
        renderHabits();
        showToast('New habit created.');
      });

      // Study Plan Form Submit
      document.getElementById('studyForm').addEventListener('submit', e => {
        e.preventDefault();
        const subject = document.getElementById('studySubjectInput').value.trim();
        if (!subject) return;
        const rawTopics = document.getElementById('studyTopicsInput').value
          .split(',')
          .map(s => s.trim())
          .filter(Boolean);

        const topics = rawTopics.length
          ? rawTopics.map(name => ({ name, done: false }))
          : [{ name: 'Initial review & practice', done: false }];

        state.data.studyPlans.unshift({
          id: 's_' + Date.now(),
          exam: document.getElementById('studyExamType').value,
          subject,
          date: document.getElementById('studyExamDate').value,
          topics
        });
        saveState();
        closeModal('studyModal');
        renderStudyPlanner();
        showToast('Study plan added.');
      });

      // Search, Filters & Sort Listeners
      ['taskSearchInput', 'filterCategory', 'filterStatus', 'filterPriority', 'sortTasksSelect'].forEach(id => {
        document.getElementById(id).addEventListener('input', renderMyTasks);
      });

      // Calendar Controls
      document.getElementById('calPrevBtn').addEventListener('click', () => {
        state.calendarMonth.setMonth(state.calendarMonth.getMonth() - 1);
        renderCalendar();
      });
      document.getElementById('calNextBtn').addEventListener('click', () => {
        state.calendarMonth.setMonth(state.calendarMonth.getMonth() + 1);
        renderCalendar();
      });
      document.getElementById('calTodayBtn').addEventListener('click', () => {
        state.calendarMonth = new Date();
        state.selectedCalendarDate = getTodayStr(0);
        renderCalendar();
      });

      // Study Planner Filter Pills
      document.querySelectorAll('.exam-pill').forEach(pill => {
        pill.addEventListener('click', () => {
          document.querySelectorAll('.exam-pill').forEach(p => p.classList.remove('active'));
          pill.classList.add('active');
          state.selectedExamFilter = pill.dataset.exam;
          renderStudyPlanner();
        });
      });

      // Pomodoro Controls
      document.querySelectorAll('.mode-tab').forEach(tab => {
        tab.addEventListener('click', () => {
          setTimerMode(tab.dataset.mode, Number(tab.dataset.minutes));
        });
      });
      document.getElementById('timerStartPauseBtn').addEventListener('click', () => {
        timerState.isRunning ? pauseTimer() : startTimer();
      });
      document.getElementById('timerResetBtn').addEventListener('click', () => {
        pauseTimer();
        timerState.remainingSeconds = timerState.totalSeconds;
        document.getElementById('timerStatusLabel').textContent = 'Ready to focus';
        updateTimerUI();
      });

      // Settings Controls
      document.getElementById('saveSettingsBtn').addEventListener('click', () => {
        state.data.settings.userName = document.getElementById('settingsUserName').value.trim();
        state.data.settings.theme = document.getElementById('settingsThemeSelect').value;
        applyTheme(state.data.settings.theme);
        saveState();
        renderAll();
        showToast('Settings saved.');
      });

      document.getElementById('resetSampleDataBtn').addEventListener('click', () => {
        state.data = createDefaultData();
        applyTheme(state.data.settings.theme);
        saveState();
        renderAll();
        showToast('Sample data restored.');
      });

      document.getElementById('clearAllDataBtn').addEventListener('click', () => {
        state.data = {
          settings: { theme: state.data.settings.theme, userName: '' },
          tasks: [],
          habits: [],
          studyPlans: [],
          focusSessions: 0
        };
        saveState();
        renderAll();
        showToast('All workspace data cleared.');
      });

      // Close modals on backdrop click
      document.querySelectorAll('.modal-overlay').forEach(overlay => {
        overlay.addEventListener('click', e => {
          if (e.target === overlay) overlay.classList.remove('open');
        });
      });
    });
  </script>
</body>
</html>
